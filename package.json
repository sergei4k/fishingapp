{
  "name": "fishingapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "import:moscow-water": "node scripts/import-moscow-water-bodies.mjs",
    "clean": "find node_modules -path '*/android/build' -type d -prune -exec rm -rf {} + 2>/dev/null; find node_modules -path '*/android/.cxx' -type d -prune -exec rm -rf {} + 2>/dev/null; true",
    "build:production": "npm run clean && npx eas-cli build --platform android --profile production",
    "build:rustore": "npm run clean && npx eas-cli build --platform android --profile rustore"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/oswald": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@rnmapbox/maps": "^10.3.5",
    "bad-words": "^4.0.0",
    "dotenv": "^17.2.3",
