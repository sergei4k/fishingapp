{
  "name": "fishingapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "clean": "find node_modules -path '*/android/build' -type d -prune -exec rm -rf {} + 2>/dev/null; find node_modules -path '*/android/.cxx' -type d -prune -exec rm -rf {} + 2>/dev/null; true",
    "build:production": "npm run clean && eas build --platform android --profile production",
    "build:rustore": "npm run clean && eas build --platform android --profile rustore"
  },
